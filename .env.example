DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessorai_dados
GITHUB_DATA_REPOSITORY=assessorAI/assessorai-dados
GITHUB_DATA_RELEASE=latest
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PUBLIC_RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_PER_MINUTE=600
# Comma-separated SHA-256 hashes of API keys. Never store raw keys here.
PUBLIC_API_KEY_HASHES=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*,https://SEU-DOMINIO
